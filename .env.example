# This file documents env vars for the root/AI workspace and the frontend's
# demo bridge to backend/api. backend/api owns its own persistence and AI
# gateway config — see backend/api/.env.example for MONGO_URI, JWT_SECRET,
# GEMINI_API_KEY, and INTERNAL_AI_KEY.

# AI Judge + AI Coach — Gemini (optional; ai/ package tests don't need it,
# backend/api needs its own copy in backend/api/.env to make live calls)
GEMINI_API_KEY=

# Frontend -> backend/api bridge (frontend/app/api/coach/route.ts). Only
# used by the AI Coach page — everything else in the frontend is still the
# mock store. Must match backend/api's PORT (see backend/api/.env.example).
BACKEND_API_URL=http://localhost:5000/api
# Shared demo password used to transparently provision/log in a shadow
# backend/api account per demo user email — see
# frontend/lib/services/backendClient.ts. Change it (and keep it out of
# anything committed) before this touches real users.
BACKEND_DEMO_PASSWORD=katalyst-demo-bridge-2026

# Registration document OCR (frontend/app/api/ocr/route.ts). Free key from
# https://ocr.space/ocrapi — 25,000 requests/month, 1MB/file. Leave unset
# to have OCR return empty fields (the form still works, just unassisted).
OCR_SPACE_API_KEY=
