# AI Judge + AI Coach — Gemini (optional; not required for the demo UI)
GEMINI_API_KEY=

# MongoDB (optional; demo uses in-memory mock services)
MONGODB_URI=mongodb://127.0.0.1:27017/katalyst

# Frontend -> backend-1 bridge (frontend/app/api/coach/route.ts). Only used
# by the AI Coach page — everything else in the frontend is still the mock
# store. Must match backend-1's PORT (see backend-1/.env.example).
BACKEND_API_URL=http://localhost:5000/api
# Shared demo password used to transparently provision/log in a shadow
# backend-1 account per demo user email — see backend1Client.ts. Change it
# (and keep it out of anything committed) before this touches real users.
BACKEND_DEMO_PASSWORD=katalyst-demo-bridge-2026
