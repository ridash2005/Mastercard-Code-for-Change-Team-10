# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection. Local dev: point at a local daemon or an Atlas
# mongodb+srv:// URI, either works. Deploying to Vercel: see
# README.md's "Deploying to Vercel" section - mongodb+srv:// doesn't
# resolve from Vercel's serverless functions, use the expanded
# mongodb://host1,host2,host3/... form there instead.
MONGO_URI=mongodb://127.0.0.1:27017/katalyst

# JWT Configuration
JWT_SECRET=supersecretjwtkey_katalyst_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:3000

# AI gateway (backend/api -> ai/ai-client -> Gemini). See routes/aiRoutes.js
# and services/ai/* — this is the only path into /ai; frontend never calls
# it directly. Leave GEMINI_API_KEY unset to run the AI Coach in fixture
# mode (no live calls, no key required) for local dev.
GEMINI_API_KEY=

# Shared secret required (in addition to an admin JWT) for internal,
# non-client-facing AI routes such as judge scoring. No default — the
# route is disabled (503) until this is set. Generate a long random value,
# never reuse JWT_SECRET.
INTERNAL_AI_KEY=

# Password reset email delivery (services/emailService.js), via Resend
# (https://resend.com). Leave RESEND_API_KEY unset to run forgot-password in
# dev mode: the reset link is returned directly in the API response instead
# of being emailed - fine for local dev, never for production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Katalyst <onboarding@resend.dev>

# Base URL the password reset link points at (the frontend, not this API).
FRONTEND_URL=http://localhost:3000
